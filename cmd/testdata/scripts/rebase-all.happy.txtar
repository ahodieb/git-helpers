# Happy path: main advances after b1/b2 fork off; rebase-all should
# replay each branch's commit on top of the new main, and leave HEAD
# back on main.
#
# Note: the cherry safety check looks at HEAD's upstream, so this only
# works cleanly when the run starts from main (with main tracking an
# upstream). Running from a feature branch without an upstream fails
# the cherry call — that's a known limitation of the current code.

# bare origin so the cherry check has something to compare against.
exec git init -q --bare origin

cd repo
exec git remote add origin ../origin
exec git push -q -u origin main

# fork b1 and b2 off the initial commit, each with their own commit.
exec git checkout -b b1
exec git commit -q --allow-empty -m 'b1: B1'
exec git checkout -b b2 main
exec git commit -q --allow-empty -m 'b2: B2'

# advance main by one commit and publish it (simulates "fetched a new main").
exec git checkout main
exec git commit -q --allow-empty -m 'main: M1'
exec git push -q

exec git-helpers -C . rebase-all

# HEAD is back on main after the run.
exec git branch --show-current
stdout '^main$'

# b1 and b2 each contain main's M1 followed by their own commit.
exec git log --format=%s b1
cmp stdout ../expected-b1.log

exec git log --format=%s b2
cmp stdout ../expected-b2.log

-- expected-b1.log --
b1: B1
main: M1
initial commit
-- expected-b2.log --
b2: B2
main: M1
initial commit
