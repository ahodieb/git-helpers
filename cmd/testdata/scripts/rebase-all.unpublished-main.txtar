# rebase-all aborts when main has commits that aren't on its upstream.
# This is the safety check in cmd/rebase-all.go — we don't want to
# silently rebase feature branches on top of unpushed local commits.

exec git init -q --bare origin

cd repo
exec git remote add origin ../origin
exec git push -q -u origin main

# add an unpublished commit on main.
exec git commit -q --allow-empty -m 'main: unpushed'

# fork a feature branch with its own commit so we'd notice if it got rebased.
exec git checkout -b b1
exec git commit -q --allow-empty -m 'b1: B1'

# back on main when we run rebase-all (cherry compares HEAD vs upstream).
exec git checkout main

exec git-helpers -C . rebase-all
stderr 'unpublished commits'

# b1 was not rebased: its parent is still the original initial commit.
exec git log --format=%s b1
cmp stdout ../expected-b1.log

-- expected-b1.log --
b1: B1
main: unpushed
initial commit
